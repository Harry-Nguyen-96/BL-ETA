rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /shipments/{blNumber} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'blNumber', 'vesselName', 'voyageNumber', 'eta', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.blNumber == blNumber
        && request.resource.data.blNumber is string
        && request.resource.data.blNumber.matches('^[A-Z0-9-]+$')
        && request.resource.data.blNumber.size() <= 60
        && request.resource.data.vesselName is string
        && request.resource.data.vesselName.size() <= 100
        && request.resource.data.voyageNumber is string
        && request.resource.data.voyageNumber.size() <= 60
        && request.resource.data.eta is string
        && request.resource.data.eta.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
